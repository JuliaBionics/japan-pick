  {id:6, name:'DHC 약용 딥클렌징 오일', cat:'뷰티', catKey:'beauty', origin:'japan', jpy:1980, rating:4.7, reviews:389, badge:null, group:'beauty'},
  {id:7, name:'하다라보 고쿠쥰 히알루론 로션', cat:'뷰티', catKey:'beauty', origin:'japan', jpy:1450, rating:4.6, reviews:276, badge:null, group:'beauty'},
  {id:8, name:'DHC 비타민C 90일분', cat:'건강식품', catKey:'health', origin:'japan', jpy:1200, rating:4.7, reviews:520, badge:'BEST', group:'health'},
  {id:9, name:'산토리 세사민 EX 90정', cat:'건강식품', catKey:'health', origin:'japan', jpy:3400, rating:4.8, reviews:334, badge:null, group:'health'},
  {id:10, name:'오츠카 네이처메이드 종합비타민', cat:'건강식품', catKey:'health', origin:'japan', jpy:1680, rating:4.6, reviews:198, badge:null, group:'health'},
  {id:11, name:'일본산 티타늄 코팅 프라이팬 26cm', cat:'주방용품', catKey:'kitchen', origin:'japan', jpy:6500, rating:4.7, reviews:88, badge:null, group:'best'},
  {id:12, name:'발뮤다 더 토스터 (K05A)', cat:'생활가전', catKey:'appliance', origin:'japan', jpy:28000, rating:4.9, reviews:145, badge:'인기', group:'best'},
  {id:13, name:'스누피 미니 피규어 세트', cat:'캐릭터/굿즈', catKey:'character', origin:'japan', jpy:1980, rating:4.8, reviews:262, badge:null, group:'best'},
  {id:14, name:'무인양품 휴대용 가습기', cat:'생활가전', catKey:'appliance', origin:'japan', jpy:3200, rating:4.5, reviews:76, badge:null, group:'best'},
];

const EX_RATE = 9.5;   // 1엔 = 9.5원 (데모용 고정값)
const FEE_RATE = 0.08; // 구매대행 수수료 8% (일본 구매대행 상품에만 적용)
const SHIP_FLAT = 6000;    // 국제배송비 예상 (일본 구매대행 상품, 1건 기준)
const SHIP_DOMESTIC = 3000; // 국내배송비 (한국전용관 상품, 1건 기준)
const TAX_THRESHOLD = 150000; // 관부가세 예상 기준 (일본 구매대행 상품에만 적용)

function krwBase(jpy){ return Math.round(jpy * EX_RATE); }
function feeOf(base){ return Math.round(base * FEE_RATE); }
function taxOf(base, fee){
  const dutyBase = base + fee;
  return dutyBase > TAX_THRESHOLD ? Math.round(dutyBase * 0.1) : 0;
}
function won(n){ return n.toLocaleString('ko-KR') + '원'; }

// 상품 1개 기준 최종 결제가 계산 (원산지에 따라 분기)
function priceOf(p, qty){
  qty = qty || 1;
  if(p.origin === 'korea'){
    const base = p.krw * qty;
    return { base, fee:0, final: base };
  }
  const base = krwBase(p.jpy) * qty;
  const fee = feeOf(base);
  return { base, fee, final: base + fee };
}

function renderCard(p){
  const { base, fee, final } = priceOf(p, 1);
  const isKorea = p.origin === 'korea';
  return `
  <div class="product-card" onclick="openModal(${p.id})">
    <div class="product-thumb" style="background:${p.catKey==='julia' ? '#FFF6E3' : '#F5F3EE'}">
      ${p.badge ? `<span class="badge ${p.catKey==='julia'?'gold':''}">${p.badge}</span>` : ''}
      ${ICONS[p.catKey]}
    </div>
    <div class="product-info">
      <div class="product-cat">${p.cat}${isKorea ? ' <span class="origin-tag">국내산</span>' : ''}</div>
      <div class="product-name">${p.name}</div>
      ${isKorea
        ? `<div class="price-final">${won(final)}</div>`
        : `<div class="price-jp">일본가 ¥${p.jpy.toLocaleString()}</div><div class="price-final"><small>구매대행가</small> ${won(final)}</div>`
      }
      <div class="rating"><span class="stars">★★★★★</span> ${p.rating} (${p.reviews})</div>
    </div>
  </div>`;
}

function renderGrid(elId, list){
  document.getElementById(elId).innerHTML = list.map(renderCard).join('');
}
renderGrid('bestGrid', PRODUCTS.filter(p=>p.badge==='BEST' || p.group==='best').slice(0,8));
renderGrid('juliaGrid', PRODUCTS.filter(p=>p.group==='julia'));
renderGrid('beautyGrid', PRODUCTS.filter(p=>p.group==='beauty'));
renderGrid('healthGrid', PRODUCTS.filter(p=>p.group==='health'));

/* ---------- CALCULATOR LOGIC ---------- */
function stepQty(delta){
  const q = document.getElementById('qtyInput');
  q.value = Math.max(1, parseInt(q.value||1) + delta);
  updateCalc();
}
function updateCalc(){
  const yen = Math.max(0, parseFloat(document.getElementById('yenInput').value) || 0);
  const qty = Math.max(1, parseInt(document.getElementById('qtyInput').value) || 1);
  const base = krwBase(yen) * qty;
  const fee = feeOf(base);
  const ship = SHIP_FLAT;
  const tax = taxOf(base, fee);
  const total = base + fee + ship + tax;
  document.getElementById('calcBase').textContent = won(base);
  document.getElementById('calcFee').textContent = won(fee);
  document.getElementById('calcShip').textContent = won(ship);
  document.getElementById('calcTax').textContent = tax > 0 ? won(tax) : '해당없음';
  document.getElementById('calcTotal').textContent = won(total);
}
updateCalc();

/* ---------- CART LOGIC ---------- */
let cart = [];
function findProduct(id){ return PRODUCTS.find(p=>p.id===id); }

function addToCart(id){
  const existing = cart.find(c=>c.id===id);
  if(existing){ existing.qty += 1; } else { cart.push({id, qty:1}); }
  renderCart();
  showToast('장바구니에 상품을 담았습니다.');
}
function removeFromCart(id){
  cart = cart.filter(c=>c.id!==id);
  renderCart();
}
function renderCart(){
  const body = document.getElementById('cartBody');
  const countEl = document.getElementById('cartCount');
  const totalQty = cart.reduce((s,c)=>s+c.qty,0);
  countEl.textContent = totalQty;

  if(cart.length === 0){
    body.innerHTML = '<div class="cart-empty">장바구니가 비어있습니다.</div>';
  } else {
    body.innerHTML = cart.map(c=>{
      const p = findProduct(c.id);
      const { final } = priceOf(p, c.qty);
      return `
      <div class="cart-item">
        <div class="cart-item-thumb">${ICONS[p.catKey]}</div>
        <div class="cart-item-info">
          <div class="cat">${p.cat}${p.origin==='korea' ? ' <span class="origin-tag">국내산</span>' : ''}</div>
          <h4>${p.name}</h4>
          <div class="cart-item-price">${won(final)} <span style="color:var(--muted); font-weight:500;">× ${c.qty}개</span></div>
          <div class="cart-item-remove" onclick="removeFromCart(${p.id})">삭제</div>
        </div>
      </div>`;
    }).join('');
  }

  let subtotal = 0, feeTotal = 0, hasJapan = false, hasKorea = false;
  cart.forEach(c=>{
    const p = findProduct(c.id);
    const { base, fee } = priceOf(p, c.qty);
    subtotal += base;
    feeTotal += fee;
    if(p.origin === 'korea'){ hasKorea = true; } else { hasJapan = true; }
  });
  const shipTotal = (hasJapan ? SHIP_FLAT : 0) + (hasKorea ? SHIP_DOMESTIC : 0);
  const grand = subtotal + feeTotal + shipTotal;
  document.getElementById('cartSubtotal').textContent = won(subtotal);
  document.getElementById('cartFee').textContent = won(feeTotal);
  document.getElementById('cartShip').textContent = won(shipTotal);
  document.getElementById('cartGrand').textContent = won(grand);
}

const cartDrawer = document.getElementById('cartDrawer');
const overlay = document.getElementById('overlay');
document.getElementById('cartBtn').addEventListener('click', e=>{
  e.preventDefault();
  cartDrawer.classList.add('open');
  overlay.classList.add('open');
});
document.getElementById('cartClose').addEventListener('click', closeCart);
overlay.addEventListener('click', ()=>{ closeCart(); closeModal(); });
function closeCart(){ cartDrawer.classList.remove('open'); overlay.classList.remove('open'); }

/* ---------- MODAL LOGIC ---------- */
const modalOverlay = document.getElementById('modalOverlay');
let currentModalId = null;
function openModal(id){
  const p = findProduct(id);
  currentModalId = id;
  const isKorea = p.origin === 'korea';
  document.getElementById('modalCat').textContent = p.cat + (isKorea ? ' · 국내산' : '');
  document.getElementById('modalName').textContent = p.name;
  const { base, fee, final } = priceOf(p, 1);

  document.getElementById('modalPriceBlock').innerHTML = isKorea
    ? `<div class="calc-row total" style="border-top:none; padding-top:6px;"><span>판매가</span><span>${won(final)}</span></div>`
    : `<div class="calc-row"><span>일본 판매가</span><span>¥${p.jpy.toLocaleString()}</span></div>
       <div class="calc-row total" style="border-top:none; padding-top:6px;"><span>구매대행 최종가</span><span>${won(final)}</span></div>`;

  document.getElementById('modalMeta').innerHTML = isKorea
    ? `<p><strong>예상 배송기간</strong> 결제 완료 후 1~2일 (국내 물류센터 출고)</p>
       <p style="margin-top:8px;"><strong>관세/부가세 안내</strong> 국내 정식 유통 제품으로 관부가세가 발생하지 않습니다.</p>`
    : `<p><strong>예상 배송기간</strong> 결제 완료 후 7~12일 (일본 현지 구매 2~3일 + 국제배송 5~9일)</p>
       <p style="margin-top:8px;"><strong>관부가세 안내</strong> 합산 통관금액 15만원 초과 시 관세·부가세가 별도 부과될 수 있습니다.</p>`;

  document.getElementById('modalVisual').innerHTML = ICONS[p.catKey];
  modalOverlay.classList.add('open');
}
function closeModal(){ modalOverlay.classList.remove('open'); currentModalId = null; }
document.getElementById('modalClose').addEventListener('click', closeModal);
document.getElementById('modalAddBtn').addEventListener('click', ()=>{
  if(currentModalId){ addToCart(currentModalId); closeModal(); }
});

/* ---------- TOAST ---------- */
let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2400);
}

/* ---------- NAV ACTIVE STATE ---------- */
document.querySelectorAll('.category-nav a').forEach(link=>{
  link.addEventListener('click', ()=>{
    document.querySelectorAll('.category-nav a').forEach(l=>l.classList.remove('active'));
    link.classList.add('active');
  });
});
</script>
</body>
</html>
