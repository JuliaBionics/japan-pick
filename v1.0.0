<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JAPAN PICK | 일본 구매대행 전문몰</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='29' fill='%23fff' stroke='%23E0980C' stroke-width='1.6'/%3E%3Cpath d='M32 5 A27 27 0 0 1 32 59 A13.5 13.5 0 0 1 32 32 A13.5 13.5 0 0 0 32 5 Z' fill='%23F0483A'/%3E%3Cpath d='M32 5 A27 27 0 0 0 32 59 A13.5 13.5 0 0 0 32 32 A13.5 13.5 0 0 1 32 5 Z' fill='%231499B8'/%3E%3Ccircle cx='32' cy='18.5' r='5.2' fill='%23fff'/%3E%3Ccircle cx='32' cy='18.5' r='5.2' fill='none' stroke='%23F0483A' stroke-width='1.3'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FFF8EF;
    --surface: #FFFFFF;
    --ink: #22303F;
    --indigo: #1499B8;
    --indigo-dark: #0B7690;
    --vermillion: #F0483A;
    --vermillion-dark: #CE3327;
    --gold: #E0980C;
    --gold-bg: #FFF3D9;
    --green: #17A673;
    --line: #F1E3C9;
    --muted: #8B7E6E;
    --hero-accent: #FFD666;
    --font-display: 'Noto Sans KR', sans-serif;
    --font-body: 'Noto Sans KR', sans-serif;
    --radius: 10px;
    --shadow: 0 4px 16px rgba(34,48,63,0.08);
    --shadow-lg: 0 12px 32px rgba(34,48,63,0.16);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--ink);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img,svg{display:block; max-width:100%;}
  a{color:inherit; text-decoration:none;}
  button{font-family:inherit; cursor:pointer; border:none;}
  ul{list-style:none;}
  .container{max-width:1200px; margin:0 auto; padding:0 24px;}
  .eyebrow{
    font-size:14px; font-weight:700; letter-spacing:0.06em; color: var(--vermillion);
    text-transform:uppercase; display:flex; align-items:center; gap:8px; margin-bottom:10px;
  }
  .eyebrow::before{content:''; width:18px; height:2px; background:var(--vermillion); display:inline-block;}
  h1,h2,h3{font-family:var(--font-display); color:var(--ink); font-weight:900;}
  .section{padding:64px 0;}
  .section-title{font-size:28px; margin-bottom:6px;}
  .section-sub{color:var(--muted); font-size:15px; margin-bottom:32px;}
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:14px 26px; border-radius:8px; font-weight:700; font-size:16px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{transform: translateY(-1px);}
  .btn-primary{background:var(--vermillion); color:#fff; box-shadow:0 6px 18px rgba(193,59,52,0.28);}
  .btn-primary:hover{background:var(--vermillion-dark);}
  .btn-outline{background:#fff; color:var(--indigo); border:1.5px solid var(--indigo);}
  .btn-outline:hover{background:var(--indigo); color:#fff;}
  .btn-block{width:100%;}

  /* ---------- TOP UTILITY BAR ---------- */
  .topbar{background:var(--indigo-dark); color:#EAF0F7; font-size:13.5px;}
  .topbar .container{display:flex; justify-content:space-between; align-items:center; height:38px;}
  .topbar-tel{font-weight:700; letter-spacing:.02em;}
  .topbar-links{display:flex; gap:18px;}
  .topbar-links a{opacity:.9;}
  .topbar-links a:hover{opacity:1; text-decoration:underline;}

  /* ---------- HEADER ---------- */
  header.main-header{background:var(--surface); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:50;}
  .header-row{display:flex; align-items:center; gap:28px; padding:18px 24px; max-width:1200px; margin:0 auto;}
  .logo{font-size:26px; font-weight:900; color:var(--indigo); white-space:nowrap; display:flex; align-items:center; gap:10px; letter-spacing:.01em;}
  .logo-mark{width:38px; height:38px; flex-shrink:0;}
  .search-form{flex:1; display:flex; max-width:560px;}
  .search-form input{
    flex:1; border:2px solid var(--indigo); border-right:none; border-radius:8px 0 0 8px;
    padding:13px 16px; font-size:16px; outline:none; font-family:inherit;
  }
  .search-form button{
    background:var(--indigo); color:#fff; padding:0 22px; border-radius:0 8px 8px 0; font-size:16px; font-weight:700;
  }
  .header-actions{display:flex; align-items:center; gap:22px; font-size:14.5px; font-weight:500; white-space:nowrap;}
  .header-actions .icon-label{display:flex; flex-direction:column; align-items:center; gap:4px; position:relative;}
  .cart-count{
    position:absolute; top:-8px; right:-12px; background:var(--vermillion); color:#fff; font-size:11px; font-weight:800;
    border-radius:50%; width:19px; height:19px; display:flex; align-items:center; justify-content:center;
  }

  .category-nav{background:var(--indigo); }
  .category-nav ul{display:flex; max-width:1200px; margin:0 auto; padding:0 24px; overflow-x:auto;}
  .category-nav li{flex-shrink:0;}
  .category-nav a{
    display:block; padding:14px 20px; color:#DCE6F2; font-weight:700; font-size:15px; white-space:nowrap;
    border-bottom:3px solid transparent;
  }
  .category-nav a:hover, .category-nav a.active{color:#fff; border-bottom-color:var(--vermillion);}
  .category-nav a.special{color:var(--hero-accent);}
  .category-nav a.special:hover{border-bottom-color:var(--hero-accent);}
  .category-nav .nav-divider{width:1px; background:rgba(255,255,255,0.18); margin:10px 4px; flex-shrink:0;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative; overflow:hidden;
    background:linear-gradient(135deg, #0B7690 0%, #1499B8 42%, #F0483A 100%);
    background-image:
      radial-gradient(circle at 15% 15%, rgba(255,255,255,0.10) 0, transparent 55%),
      linear-gradient(135deg, #0B7690 0%, #1499B8 42%, #F0483A 100%),
      url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="120" height="60"><path d="M0 30 Q15 10 30 30 T60 30 T90 30 T120 30" stroke="rgba(255,255,255,0.10)" fill="none" stroke-width="2"/><path d="M0 45 Q15 25 30 45 T60 45 T90 45 T120 45" stroke="rgba(255,255,255,0.07)" fill="none" stroke-width="2"/></svg>');
  }
  .hero .container{display:grid; grid-template-columns:1.1fr 0.9fr; gap:40px; align-items:center; padding-top:56px; padding-bottom:56px;}
  .hero-eyebrow{color:var(--hero-accent); font-weight:700; font-size:14px; letter-spacing:.08em; margin-bottom:14px; display:flex; align-items:center; gap:8px;}
  .hero-eyebrow::before{content:''; width:18px; height:2px; background:var(--hero-accent);}
  .hero h1{color:#fff; font-size:42px; line-height:1.3; margin-bottom:18px;}
  .hero h1 span{color:var(--hero-accent);}
  .hero p{color:#FDF4EA; font-size:17px; margin-bottom:28px; max-width:480px;}
  .hero-ctas{display:flex; gap:12px;}
  .hero-visual{position:relative; height:320px;}
  .route-svg{width:100%; height:100%;}

  /* ---------- TRUST STRIP ---------- */
  .trust-strip{background:#fff; border-bottom:1px solid var(--line);}
  .trust-strip .container{display:grid; grid-template-columns:repeat(4,1fr); gap:0; padding-top:28px; padding-bottom:28px;}
  .trust-item{display:flex; align-items:center; gap:14px; padding:0 20px; border-left:1px solid var(--line);}
  .trust-item:first-child{border-left:none;}
  .trust-item .ic{width:44px; height:44px; flex-shrink:0; color:var(--indigo);}
  .trust-item strong{display:block; font-size:15.5px; margin-bottom:2px;}
  .trust-item span{color:var(--muted); font-size:13.5px;}

  /* ---------- CALCULATOR (SIGNATURE) ---------- */
  .calc-section{background:var(--gold-bg); border-top:1px solid #F5D999; border-bottom:1px solid #F5D999;}
  .calc-wrap{display:grid; grid-template-columns:0.9fr 1.1fr; gap:48px; align-items:center;}
  .calc-copy h2{font-size:30px; margin-bottom:14px;}
  .calc-copy p{color:#5B4C33; margin-bottom:20px; max-width:420px;}
  .calc-copy ul{display:flex; flex-direction:column; gap:10px;}
  .calc-copy li{display:flex; align-items:center; gap:10px; font-size:15px; color:#5B4C33; font-weight:500;}
  .calc-copy li::before{content:'✓'; color:var(--green); font-weight:900;}
  .calc-card{
    background:#fff; border-radius:16px; box-shadow:var(--shadow-lg); padding:32px; border:1px solid #F5D999;
  }
  .calc-field{margin-bottom:18px;}
  .calc-field label{display:block; font-weight:700; font-size:14.5px; margin-bottom:8px; color:var(--ink);}
  .calc-input-row{display:flex; align-items:center; gap:10px;}
  .calc-input-row .yen-input{
    flex:1; position:relative;
  }
  .calc-input-row .yen-input span{
    position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted); font-weight:700;
  }
  .calc-input-row input[type=number]{
    width:100%; padding:13px 14px 13px 32px; border:1.5px solid var(--line); border-radius:8px; font-size:17px;
    font-weight:700; font-family:inherit;
  }
  .calc-input-row input[type=number]:focus{outline:none; border-color:var(--indigo);}
  .qty-stepper{display:flex; align-items:center; border:1.5px solid var(--line); border-radius:8px; overflow:hidden;}
  .qty-stepper button{width:40px; height:48px; background:#F5F3EE; font-size:18px; font-weight:700; color:var(--indigo);}
  .qty-stepper input{width:44px; text-align:center; border:none; font-size:16px; font-weight:700; font-family:inherit;}
  .calc-breakdown{margin-top:22px; border-top:2px dashed #F5D999; padding-top:18px;}
  .calc-row{display:flex; justify-content:space-between; font-size:14.5px; color:var(--muted); padding:5px 0;}
  .calc-row.total{
    color:var(--ink); font-size:19px; font-weight:900; border-top:1px solid var(--line); margin-top:8px; padding-top:14px;
  }
  .calc-row.total span:last-child{color:var(--vermillion);}
  .calc-note{font-size:12.5px; color:var(--muted); margin-top:10px; line-height:1.5;}

  /* ---------- PRODUCT GRID ---------- */
  .product-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:22px;}
  .product-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; cursor:pointer;
    transition:box-shadow .15s ease, transform .15s ease; display:flex; flex-direction:column;
  }
  .product-card:hover{box-shadow:var(--shadow-lg); transform:translateY(-3px);}
  .product-thumb{
    aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; position:relative;
  }
  .product-thumb svg{width:56%; height:56%;}
  .badge{
    position:absolute; top:10px; left:10px; background:var(--vermillion); color:#fff; font-size:11.5px;
    font-weight:800; padding:4px 9px; border-radius:5px;
  }
  .badge.gold{background:var(--gold);}
  .product-info{padding:16px; display:flex; flex-direction:column; gap:6px; flex:1;}
  .product-cat{font-size:12px; color:var(--muted); font-weight:700;}
  .origin-tag{color:var(--green); font-weight:800;}
  .product-name{font-size:15.5px; font-weight:700; line-height:1.4; min-height:44px;}
  .price-jp{font-size:13px; color:var(--muted); text-decoration:line-through;}
  .price-final{font-size:19px; font-weight:900; color:var(--ink);}
  .price-final small{font-size:13px; font-weight:700; color:var(--vermillion);}
  .rating{font-size:13px; color:var(--muted); display:flex; gap:4px; align-items:center;}
  .rating .stars{color:#E0A831;}

  /* ---------- CATEGORY SECTION VARIANTS ---------- */
  .julia-section{background:linear-gradient(180deg,var(--gold-bg) 0%, #fff 100%); border-top:3px solid var(--gold); border-bottom:1px solid #F5D999;}
  .julia-banner{
    display:flex; align-items:center; gap:14px; background:#fff; border:1.5px solid #F5D999; border-radius:10px;
    padding:14px 18px; margin-bottom:28px; flex-wrap:wrap;
  }
  .julia-flag{
    background:var(--gold); color:#fff; font-size:12px; font-weight:900; letter-spacing:.04em;
    padding:6px 12px; border-radius:6px; flex-shrink:0;
  }
  .julia-banner p{font-size:14px; color:#5B4C33; margin:0;}
  .julia-banner p strong{color:var(--ink);}
  .julia-header{display:flex; align-items:center; justify-content:space-between; margin-bottom:28px; flex-wrap:wrap; gap:16px;}
  .julia-title{display:flex; align-items:center; gap:14px;}
  .julia-mark{
    width:52px; height:52px; border-radius:50%; background:var(--gold); color:#fff; display:flex; align-items:center;
    justify-content:center; font-family:var(--font-display); font-weight:900; font-size:20px; flex-shrink:0;
  }
  .julia-title h2{font-size:26px; margin-bottom:2px;}
  .julia-title p{color:#8A6B34; font-size:14px; font-weight:500;}
  .view-more{font-weight:700; color:var(--indigo); font-size:14.5px; display:flex; align-items:center; gap:6px;}
  .view-more:hover{text-decoration:underline;}

  /* ---------- PROCESS ---------- */
  .process-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:0; position:relative;}
  .process-step{text-align:center; padding:0 18px; position:relative;}
  .process-step::after{
    content:''; position:absolute; top:34px; right:-18px; width:36px; height:2px; background:var(--line);
  }
  .process-step:last-child::after{display:none;}
  .step-num{
    width:68px; height:68px; border-radius:50%; background:var(--indigo); color:#fff; font-family:var(--font-display);
    font-weight:900; font-size:24px; display:flex; align-items:center; justify-content:center; margin:0 auto 18px;
  }
  .process-step h3{font-size:17px; margin-bottom:8px;}
  .process-step p{font-size:14px; color:var(--muted); line-height:1.5;}

  /* ---------- FOOTER ---------- */
  footer{background:var(--indigo-dark); color:#B9C6D6; padding:52px 0 28px;}
  .footer-grid{display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:36px; margin-bottom:36px;}
  .footer-grid h4{color:#fff; font-size:15px; margin-bottom:16px; font-family:var(--font-body); font-weight:700;}
  .footer-grid li{margin-bottom:9px; font-size:14px;}
  .footer-grid li a:hover{color:#fff; text-decoration:underline;}
  .footer-logo{font-size:22px; font-weight:900; color:#fff; margin-bottom:14px; display:flex; align-items:center; gap:10px;}
  .footer-logo .logo-mark{width:30px; height:30px;}
  .footer-grid p{font-size:13.5px; line-height:1.7; color:#9DACC0;}
  .footer-bottom{border-top:1px solid rgba(255,255,255,0.12); padding-top:22px; font-size:12.5px; color:#8493A8; display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;}

  /* ---------- CART DRAWER ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(27,42,61,0.45); opacity:0; pointer-events:none; transition:opacity .2s ease; z-index:90;
  }
  .overlay.open{opacity:1; pointer-events:auto;}
  .cart-drawer{
    position:fixed; top:0; right:0; height:100%; width:420px; max-width:92vw; background:#fff; z-index:100;
    transform:translateX(100%); transition:transform .25s ease; display:flex; flex-direction:column; box-shadow:-8px 0 24px rgba(0,0,0,0.15);
  }
  .cart-drawer.open{transform:translateX(0);}
  .cart-head{padding:20px 22px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center;}
  .cart-head h3{font-size:19px;}
  .cart-close{font-size:24px; color:var(--muted); line-height:1;}
  .cart-body{flex:1; overflow-y:auto; padding:18px 22px;}
  .cart-empty{color:var(--muted); text-align:center; padding:60px 0; font-size:15px;}
  .cart-item{display:flex; gap:12px; padding:16px 0; border-bottom:1px solid var(--line);}
  .cart-item-thumb{width:64px; height:64px; border-radius:8px; background:#F5F3EE; flex-shrink:0; display:flex; align-items:center; justify-content:center;}
  .cart-item-thumb svg{width:60%; height:60%;}
  .cart-item-info{flex:1; min-width:0;}
  .cart-item-info h4{font-size:14.5px; font-weight:700; margin-bottom:4px;}
  .cart-item-info .cat{font-size:12px; color:var(--muted); margin-bottom:6px;}
  .cart-item-price{font-weight:800; font-size:15px;}
  .cart-item-remove{font-size:12.5px; color:var(--vermillion); font-weight:700; margin-top:6px;}
  .cart-foot{padding:20px 22px; border-top:1px solid var(--line);}
  .cart-total-row{display:flex; justify-content:space-between; font-size:14px; color:var(--muted); padding:4px 0;}
  .cart-total-row.grand{font-size:19px; font-weight:900; color:var(--ink); border-top:1px solid var(--line); margin-top:8px; padding-top:12px;}
  .cart-total-row.grand span:last-child{color:var(--vermillion);}

  /* ---------- PRODUCT MODAL ---------- */
  .modal-overlay{
    position:fixed; inset:0; background:rgba(27,42,61,0.55); z-index:110; display:none; align-items:center; justify-content:center; padding:20px;
  }
  .modal-overlay.open{display:flex;}
  .modal-card{
    background:#fff; border-radius:14px; max-width:760px; width:100%; max-height:88vh; overflow-y:auto;
    display:grid; grid-template-columns:1fr 1fr; box-shadow:var(--shadow-lg); position:relative;
  }
  .modal-close{position:absolute; top:14px; right:16px; font-size:24px; color:var(--muted); z-index:2;}
  .modal-visual{background:#F5F3EE; display:flex; align-items:center; justify-content:center; padding:40px;}
  .modal-visual svg{width:70%; height:70%;}
  .modal-info{padding:32px 30px;}
  .modal-info .product-cat{margin-bottom:8px;}
  .modal-info h3{font-size:21px; margin-bottom:12px; line-height:1.4;}
  .modal-price-block{background:#F8F7F3; border-radius:10px; padding:16px; margin-bottom:18px;}
  .modal-option{margin-bottom:16px;}
  .modal-option label{display:block; font-weight:700; font-size:14px; margin-bottom:8px;}
  .modal-option select{width:100%; padding:12px; border:1.5px solid var(--line); border-radius:8px; font-size:15px; font-family:inherit;}
  .modal-meta{font-size:13px; color:var(--muted); line-height:1.7; margin-top:16px; border-top:1px solid var(--line); padding-top:16px;}
  .modal-meta strong{color:var(--ink);}

  .toast{
    position:fixed; bottom:28px; left:50%; transform:translateX(-50%) translateY(20px); background:var(--ink); color:#fff;
    padding:14px 26px; border-radius:8px; font-size:14.5px; font-weight:600; opacity:0; pointer-events:none;
    transition:opacity .2s ease, transform .2s ease; z-index:200; white-space:nowrap;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 980px){
    .hero .container{grid-template-columns:1fr;}
    .hero-visual{height:200px; order:-1;}
    .calc-wrap{grid-template-columns:1fr;}
    .trust-strip .container{grid-template-columns:repeat(2,1fr); row-gap:20px;}
    .trust-item{border-left:none; padding:0;}
    .product-grid{grid-template-columns:repeat(2,1fr);}
    .process-grid{grid-template-columns:repeat(2,1fr); row-gap:36px;}
    .process-step::after{display:none;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    .modal-card{grid-template-columns:1fr;}
  }
  @media (max-width: 600px){
    body{font-size:16px;}
    .header-row{flex-wrap:wrap;}
    .search-form{order:3; width:100%; max-width:none;}
    .hero h1{font-size:30px;}
    .product-grid{grid-template-columns:repeat(2,1fr); gap:14px;}
    .footer-grid{grid-template-columns:1fr;}
    .topbar-links a:nth-child(3){display:none;}
  }
</style>
</head>
<body>

<!-- ============ TOP BAR ============ -->
<div class="topbar">
  <div class="container">
    <div class="topbar-tel">📞 고객센터 1588-0000 (평일 09:00~18:00)</div>
    <div class="topbar-links">
      <a href="#">공지사항</a>
      <a href="#">이용가이드</a>
      <a href="#">고객센터</a>
    </div>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="main-header">
  <div class="header-row">
    <a class="logo" href="#top">
      <svg class="logo-mark" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="JAPAN PICK 로고">
        <circle cx="32" cy="32" r="29" fill="#fff" stroke="var(--gold)" stroke-width="1.6"/>
        <path d="M32 5 A27 27 0 0 1 32 59 A13.5 13.5 0 0 1 32 32 A13.5 13.5 0 0 0 32 5 Z" fill="var(--vermillion)"/>
        <path d="M32 5 A27 27 0 0 0 32 59 A13.5 13.5 0 0 0 32 32 A13.5 13.5 0 0 1 32 5 Z" fill="var(--indigo)"/>
        <circle cx="32" cy="18.5" r="5.2" fill="#fff"/>
        <circle cx="32" cy="18.5" r="5.2" fill="none" stroke="var(--vermillion)" stroke-width="1.3"/>
      </svg>
      JAPAN PICK
    </a>
    <form class="search-form" onsubmit="return false;">
